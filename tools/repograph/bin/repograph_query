#!/bin/bash
# RepoGraph query tool for SWE-agent

main() {
    local repo_path="${1:-}"
    local source_module="${2:-}"
    local source_qualpath="${3:-}"
    
    if [ -z "$repo_path" ] || [ -z "$source_module" ]; then
        echo "Usage: repograph_query <repo_path> <source_module> [<source_qualpath>]"
        return 1
    fi
    
    local server_host="${REPOGRAPH_SERVER_HOST:-${REPO_CONTAINER_NAME:-}}"
    [ -z "$server_host" ] && echo "Error: REPOGRAPH_SERVER_HOST not set" && return 1
    
    local workspace_dir="${WORKSPACE_DIR:-/ws}"
    [[ "$repo_path" != /* ]] && repo_path="${workspace_dir}/${repo_path}"
    
    # Call Python script to execute the query
    python3 /app/tools/repograph/lib/repograph_tool.py \
        --server-host "$server_host" \
        --repo-path "$repo_path" \
        --source-module "$source_module" \
        ${source_qualpath:+--source-qualpath "$source_qualpath"}
}

main "$@"

