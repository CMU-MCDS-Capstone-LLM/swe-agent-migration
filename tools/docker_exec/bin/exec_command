#!/bin/bash

# Usage: exec_command <container_name> <command>
# Example: exec_command repo-alice-biometrics_petisco__9abf7b1f6ef8c55bdddcb9a5c2eff513f6a93130 "python -m pytest -q"

set -euo pipefail

CONTAINER_NAME="${1:-}"
COMMAND="${2:-}"

if [ -z "$CONTAINER_NAME" ] || [ -z "$COMMAND" ]; then
    echo "Usage: exec_command <container_name> <command>"
    echo "Container name should be in format: repo-{identifier}"
    echo "Example: repo-alice-biometrics_petisco__9abf7b1f6ef8c55bdddcb9a5c2eff513f6a93130"
    exit 1
fi

# Derive repo folder from container name: repo-<folder_name>
REPO_FOLDER="$CONTAINER_NAME"
if [[ "$REPO_FOLDER" == repo-* ]]; then
    REPO_FOLDER="${REPO_FOLDER#repo-}"
fi

TARGET_DIR="/ws/$REPO_FOLDER"

EXEC_DIR="$TARGET_DIR"

echo "Running command in $CONTAINER_NAME (cwd: $EXEC_DIR): $COMMAND"

docker exec "$CONTAINER_NAME" sh -lc "if [ -d '$EXEC_DIR' ]; then cd '$EXEC_DIR'; else echo 'ERROR: Directory not found: $EXEC_DIR'; exit 1; fi; exec $COMMAND"

